<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goodPriceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#111827"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/good_price_intro"
            android:textColor="#374151"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:id="@+id/goodPriceInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/good_price_input_hint"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/goodPriceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="4096"
                android:minLines="4"
                android:maxLines="8"
                android:gravity="top|start"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/good_price_input_body"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <Button
            android:id="@+id/goodPriceBarcodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/good_price_barcode_action"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/goodPriceBarcodeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/good_price_barcode_ready"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/price_selection_title"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/good_price_selection_body"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/goodPriceSelectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/goodPriceSelectionCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_selection_current"
                android:textColor="#111827"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/goodPriceSelectionMember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_selection_member"
                android:textColor="#111827"
                android:textSize="15sp" />
        </RadioGroup>

        <Button
            android:id="@+id/checkGoodPriceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/check_good_price"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/clearGoodPriceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/clear_good_price"
            android:textAllCaps="false" />

        <com.valuepilot.app.GoodPriceCheckSurfaceView
            android:id="@+id/goodPriceScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/goodPriceMemoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#047857"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/clearGoodPriceMemoryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/compare_memory_clear"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/good_price_privacy"
            android:textColor="#4B5563"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
