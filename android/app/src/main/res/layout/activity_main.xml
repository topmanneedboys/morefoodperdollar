<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ValuePilot"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#111827" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Universal grocery + restaurant value ranking"
            android:textSize="16sp"
            android:textColor="#4B5563" />
        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Checking scanner status…"
            android:textStyle="bold" />
        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enable ValuePilot scanner" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="How to use"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Enable the accessibility scanner once.\n\n2. Open Uber Eats, a grocery app, restaurant app, or shopping website in your browser.\n\n3. Tap the floating VP bubble.\n\n4. Use Loaded for the current screen, Scan all for lazy/off-screen lists, or OCR when an app does not expose useful accessibility text.\n\n5. Rank by Smart, $/kg, $/L, calories/$, pizza area/$, or $/unit."
            android:textColor="#374151"
            android:lineSpacingExtra="2dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Privacy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This build performs parsing, ranking and OCR on-device. It has no network permission and does not send screen contents, account credentials or shopping data to a server."
            android:textColor="#374151" />
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Open accessibility settings" />
    </LinearLayout>
</ScrollView>
