<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vp_background"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/shellScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/shellBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/vp_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shellTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_tagline"
                android:textColor="@color/vp_text_muted"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/screenHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/vp_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vp_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/screenBackAction"
                        style="@style/Widget.ValuePilot.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:contentDescription="@string/shell_back_description"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/shell_back"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/screenEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vp_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/screenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/vp_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/screenBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/vp_text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primaryAction"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/compare_products"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.valuepilot.app.PracticalShoppingHomeSurfaceView
                android:id="@+id/homeExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.PracticalShoppingBasketSurfaceView
                android:id="@+id/basketExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.TripPlannerSurfaceView
                android:id="@+id/tripPlannerExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/searchExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_hint"
                    app:boxBackgroundColor="@color/vp_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_vp_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapSentences"
                        android:maxLength="160"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/search_action"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                     app:cornerRadius="14dp" />

                <TextView
                    android:id="@+id/searchAreaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                     android:textColor="@color/vp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/searchQuickTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/search_quick_title"
                    android:visibility="gone"
                     android:textColor="@color/vp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/searchQuickActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/quickEggs"
                             style="@style/Widget.ValuePilot.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_quick_eggs" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/quickMilk"
                             style="@style/Widget.ValuePilot.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_quick_milk" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/quickChicken"
                             style="@style/Widget.ValuePilot.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_quick_chicken" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/quickRice"
                             style="@style/Widget.ValuePilot.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_quick_rice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/quickPizza"
                             style="@style/Widget.ValuePilot.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_quick_pizza" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/searchIdentityBoundaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                     app:cardBackgroundColor="@color/vp_surface_subtle"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                     app:strokeColor="@color/vp_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_identity_badge"
                             android:textColor="@color/vp_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/search_identity_notice"
                             android:textColor="@color/vp_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/searchProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/searchStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                         android:textColor="@color/vp_text_muted"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/searchResultsHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/search_results_title"
                     android:textColor="@color/vp_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/searchResultsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/vp_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/searchResultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchLoadMoreButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/search_load_more_description"
                    android:text="@string/search_load_more"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="16dp"
                     style="@style/Widget.ValuePilot.Button.Outlined" />

                <TextView
                    android:id="@+id/searchResultsEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                     android:textColor="@color/vp_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.valuepilot.app.ProductionSearchSurfaceView
                    android:id="@+id/productionSearchSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:visibility="gone" />

            </LinearLayout>

            <com.valuepilot.app.PracticalShoppingSavedSurfaceView
                android:id="@+id/savedExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmedPurchaseHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/confirmed_purchase_history_open"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="16dp"
                style="@style/Widget.ValuePilot.Button.Outlined" />

            <com.valuepilot.app.ConfirmedPurchaseHistorySurfaceView
                android:id="@+id/confirmedPurchaseHistoryExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/priceWatchButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Price Watch"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="16dp"
                style="@style/Widget.ValuePilot.Button.Outlined" />

            <com.valuepilot.app.PriceWatchSurfaceView
                android:id="@+id/priceWatchExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.PracticalShoppingSavedStapleLaunchView
                android:id="@+id/savedStapleLaunchExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.valuepilot.app.PracticalShoppingSavedObservedPriceLaunchView
                android:id="@+id/savedObservedPriceLaunchExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceSavedSelectionSurfaceView
                android:id="@+id/observedPriceSavedSelectionExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceSavedPrefillHandoffSurfaceView
                android:id="@+id/observedPriceSavedPrefillResultExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationDraftSurfaceView
                android:id="@+id/observedPriceConfirmationDraftExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationDraftPriceInputSurfaceView
                android:id="@+id/observedPriceConfirmationDraftPriceInputExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationDraftObservedAtInputSurfaceView
                android:id="@+id/observedPriceConfirmationDraftObservedAtInputExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationDraftProofReferenceInputSurfaceView
                android:id="@+id/observedPriceConfirmationDraftProofReferenceInputExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationDraftProofContentSelectionSurfaceView
                android:id="@+id/observedPriceConfirmationDraftProofContentSelectionExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceConfirmationActionSurfaceView
                android:id="@+id/observedPriceConfirmationActionExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.valuepilot.app.StapleWatchSavedSelectionSurfaceView
                android:id="@+id/stapleWatchSetupExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.StapleWatchPolicyDraftSurfaceView
                android:id="@+id/stapleWatchPolicyExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.StapleWatchSurfaceView
                android:id="@+id/stapleWatchResultExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <com.valuepilot.app.UserObservedPriceUnitValueSurfaceView
                android:id="@+id/observedPriceUnitValueExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/screenFootnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="2dp"
                 android:textColor="@color/vp_text_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourcesLicencesButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/sources_licences"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                 style="@style/Widget.ValuePilot.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataStatusButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/data_status"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                 style="@style/Widget.ValuePilot.Button.Outlined" />

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/bottomNavArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:background="@color/vp_surface">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:background="@color/vp_surface"
             app:itemIconTint="@color/vp_bottom_nav_tint"
             app:itemTextColor="@color/vp_bottom_nav_tint"
             app:itemRippleColor="@color/vp_surface_subtle"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/valuepilot_bottom_navigation" />

    </FrameLayout>

</LinearLayout>
