<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ValuePilot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vp_primary</item>
        <item name="colorPrimaryVariant">@color/vp_primary_dark</item>
        <item name="colorOnPrimary">@color/vp_on_primary</item>
        <item name="colorSecondary">@color/vp_primary</item>
        <item name="colorSecondaryVariant">@color/vp_primary_dark</item>
        <item name="colorSurface">@color/vp_surface</item>
        <item name="colorOnSurface">@color/vp_text_primary</item>
        <item name="android:colorBackground">@color/vp_background</item>
        <item name="colorError">@color/vp_error</item>
        <item name="materialButtonStyle">@style/Widget.ValuePilot.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ValuePilot.Button.Outlined</item>
        <item name="chipStyle">@style/Widget.ValuePilot.Chip</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/vp_background</item>
        <item name="android:navigationBarColor">@color/vp_surface</item>
        <item name="android:statusBarColor">@color/vp_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.ValuePilot.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vp_on_primary</item>
        <item name="backgroundTint">@color/vp_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ValuePilot.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vp_primary_dark</item>
        <item name="backgroundTint">@color/vp_surface</item>
        <item name="strokeColor">@color/vp_outline</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ValuePilot.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/vp_surface_subtle</item>
        <item name="chipStrokeColor">@color/vp_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/vp_text_primary</item>
    </style>
</resources>
